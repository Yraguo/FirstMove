{
  "name": "firstmove",
  "productName": "先行",
  "version": "0.3.3",
  "private": true,
  "description": "FirstMove self-hosted workspace client",
  "author": "Yraguo",
  "main": "main.cjs",
  "scripts": {
    "build:windows": "node build-windows.cjs"
  },
  "build": {
    "appId": "io.github.yraguo.firstmove",
    "productName": "先行",
    "artifactName": "FirstMove-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "../../dist/desktop"
    },
    "files": [
      "main.cjs",
      "connect.html",
      "connect.js",
      "icon.png",
      "icon-win.png"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": "nsis",
      "icon": "icon-win.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "window": {
        "width": 540,
        "height": 400
      },
      "contents": [
        {
          "x": 140,
          "y": 160,
          "type": "file"
        },
        {
          "x": 400,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 140,
          "y": 320,
          "type": "file",
          "path": "../macos/卸载 先行.command"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  }
}
